<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{BA0E7A65-5D38-49D1-844E-05FCF92E4167}</ProjectGuid>
    <MainSource>StagingWorker.dpr</MainSource>
    <ProjectVersion>20.2</ProjectVersion>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Console</AppType>
    <FrameworkType>None</FrameworkType>
  </PropertyGroup>
  <PropertyGroup>
    <DCC_ExeOutput>$(MSBuildProjectDirectory)\bin\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_DcuOutput>$(MSBuildProjectDirectory)\bin\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_Namespace>System;Winapi</DCC_Namespace>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="StagingWorker.dpr">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="..\..\VittixAutoUpdater.Staging.pas" />
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Application</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source><Source Name="MainSource">StagingWorker.dpr</Source></Source>
      </Delphi.Personality>
      <Platforms><Platform value="Win32">True</Platform></Platforms>
    </BorlandProject>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
